# MailForenSIX Backend — Environment Variables
# Copy this to .env and fill in values. Never commit .env to git.

DEBUG=true
AIR_GAPPED=false

# SQLite path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./mailforensix.db

# Geolocation (ip-api.com — no key needed for free tier)
GEO_API_BASE=http://ip-api.com/json
GEO_API_BATCH=http://ip-api.com/batch

# ML model paths (populated after Phase 2 training)
MODEL_PATH=./models/mailforensix_model.pkl
VECTORIZER_PATH=./models/tfidf_vectorizer.pkl

# MaxMind offline DB (Phase 2 — download GeoLite2-City.mmdb)
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Risk weights (must sum to 1.0)
WEIGHT_AUTH=0.30
WEIGHT_INTENT=0.30
WEIGHT_GEO=0.20
WEIGHT_DOMAIN=0.20
